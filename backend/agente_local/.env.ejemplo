# Copiar como agente_local/.env en el PC del negocio y ajustar.
# Usuario MySQL propio del agente, con permisos solo sobre las tablas que usa (no root).

# BD real de la empresa: catálogo, precios, clientes, mesas, meseros, registro_dispositivos
AG_DB_EMPRESA_URL=mysql+aiomysql://usuario:clave@localhost:3306/nombre_bd_empresa

# Temporales del escritorio: pedidos, menú del día, armado y tablas ag_* del agente
AG_DB_TEMP_URL=mysql+aiomysql://usuario:clave@localhost:3306/datatemppos

# Puerto en la red local (los celulares abren http://IP-DEL-PC:8090)
AG_PUERTO=8090

# Opcional: firma de sesiones (>= 32 caracteres). Si se omite se genera en secreto.key
# AG_SECRETO=

# Textos según el tipo de negocio (se ven en la toma de pedidos y en los mensajes)
# AG_TEXTO_CUENTA=Cuenta
# AG_TEXTO_PRODUCTO=Producto
# AG_TEXTO_MESERO=Mesero
# Plurales opcionales: AG_TEXTO_CUENTAS, AG_TEXTO_PRODUCTOS, AG_TEXTO_MESEROS
